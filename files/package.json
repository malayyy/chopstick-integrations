{
  "name": "chopstick-integrations-scroll-reveal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:frames": "npm install --no-save --package-lock=false sharp && node tools/generate-mobile-frames.mjs",
    "predev": "npm run prepare:frames",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:frames",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
